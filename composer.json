{
    "name": "cable8mm/laravel-social-auth",
    "description": "Laravel social authentication package for Google, Kakao, and Naver without Socialite",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "cable8mm",
            "email": "cable8mm@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3|^8.4",
        "illuminate/support": "^12.0",
        "illuminate/http": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/session": "^12.0",
        "illuminate/encryption": "^12.0",
        "illuminate/events": "^12.0",
        "illuminate/auth": "^12.0",
        "illuminate/routing": "^12.0",
        "illuminate/validation": "^12.0",
        "illuminate/view": "^12.0",
        "firebase/php-jwt": "^6.10",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.0",
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Cable8mm\\LaravelSocialAuth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cable8mm\\LaravelSocialAuth\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cable8mm\\LaravelSocialAuth\\SocialAuthServiceProvider"
            ],
            "aliases": {
                "SocialAuth": "Cable8mm\\LaravelSocialAuth\\Facades\\SocialAuth"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "vendor/bin/phpunit",
        "pint": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "audit": {
            "block-insecure": false
        }
    }
}
