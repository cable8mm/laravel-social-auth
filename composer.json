{
    "name": "cable8mm/laravel-social-auth",
    "description": "Laravel social authentication package for Google, Kakao, and Naver without Socialite",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "cable8mm",
            "email": "cable8mm@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/session": "^12.0|^13.0",
        "illuminate/encryption": "^12.0|^13.0",
        "illuminate/events": "^12.0|^13.0",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0",
        "firebase/php-jwt": "^6.10",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "orchestra/testbench": "^10.11|^11.2",
        "orchestra/testbench-dusk": "^10.11|^11.4",
        "laravel/dusk": "^8.6",
        "phpunit/phpunit": "^11.0",
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Cable8mm\\LaravelSocialAuth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cable8mm\\LaravelSocialAuth\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cable8mm\\LaravelSocialAuth\\SocialAuthServiceProvider"
            ],
            "aliases": {
                "SocialAuth": "Cable8mm\\LaravelSocialAuth\\Facades\\SocialAuth"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "vendor/bin/phpunit -c phpunit.xml.dist",
        "test:browser": [
            "@php vendor/bin/testbench-dusk workbench:build --ansi",
            "@php vendor/bin/testbench-dusk package:dusk"
        ],
        "pint": "vendor/bin/pint",
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "@php vendor/bin/pint --ansi"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "audit": {
            "block-insecure": false
        }
    }
}
